# URL pública del sitio (usada para construir enlaces de correo, p. ej. recuperar
# contraseña). En Vercel, apunta al dominio de producción.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Valores del proyecto de Supabase (Project Settings > API en supabase.com).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Privilegios de administrador (bypassa RLS). Solo se usa en servidor,
# nunca anteponer NEXT_PUBLIC_ ni exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Conexión directa a Postgres (Supabase CLI, migraciones, acceso puntual).
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Correo transaccional (Resend). Sin esto la aplicación no envía y lo avisa por
# consola: se puede desarrollar sin credenciales.
#
# El remitente TIENE que ser del dominio verificado en Resend, con sus registros
# SPF y DKIM publicados; con cualquier otro, Resend rechaza el envío.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
CORREO_REMITENTE="RunTicket HN <no-reply@runtickethn.com>"

# Pago con tarjeta (PixelPay, la pasarela del banco). Los tres valores salen de
# PixelPay › Preferencias › Opciones del API. Sin ellos el portal no ofrece el
# pago con tarjeta y todo lo demás funciona igual. La llave secreta solo se usa
# en el servidor: nunca anteponer NEXT_PUBLIC_.
#
# El aviso de pago (webhook) se configura allí mismo: activar «Webhook» y poner
# como URL de éxito https://<dominio>/api/pagos/pixelpay
PIXELPAY_ENDPOINT="https://xxxxxxxx.pixelpay.app"
PIXELPAY_KEY_ID="BP000000000"
PIXELPAY_SECRET_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxx"
